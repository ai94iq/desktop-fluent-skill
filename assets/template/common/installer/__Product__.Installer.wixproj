<Project Sdk="WixToolset.Sdk/__V:WixToolset.Sdk@7__">
  <PropertyGroup>
    <OutputName>__Product__-Setup-$(Version)</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>ar-SA</Cultures>
    <PublishDir>$(MSBuildThisFileDirectory)..\artifacts\publish\win-x64</PublishDir>
    <DefineConstants>Version=$(Version);PublishDir=$(PublishDir)</DefineConstants>
    <!-- WiX packages are versioned here, not through CPM; keep both on the same 7.x version -->
    <!-- WiX 7 builds only after the OSMF EULA is accepted (else WIX7015); see docs/decisions/0001 -->
    <AcceptEula>wix7</AcceptEula>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- WinAppSDK ships localized .mui files that ICE03 rejects, and Files-based payloads without
         language resources trip ICE60; suppress both for that layout only -->
    <SuppressIces Condition="Exists('$(PublishDir)\Microsoft.ui.xaml.dll')">ICE03;ICE60</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="__V:WixToolset.UI.wixext@7__" />
  </ItemGroup>
</Project>
